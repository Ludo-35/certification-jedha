# Image pour le dashboard Streamlit (consomme l'API FlyOnTime, aucune
# logique ML ni connexion base de données ici)
FROM python:3.10-slim

WORKDIR /app

COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY dashboard.py .

EXPOSE 8501

# FLYONTIME_API_URL doit pointer vers l'URL publique du service API Render
CMD streamlit run dashboard.py --server.port ${PORT:-8501} --server.address 0.0.0.0
