# Image pour le service API FastAPI (prédiction de retard)
FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Code + artefacts nécessaires à l'API uniquement
COPY api.py engine.py feature_engineering.py ./
COPY model ./model
COPY cache ./cache

EXPOSE 8000

# $PORT est fourni par Render en production ; 8000 en local par défaut
CMD uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}
